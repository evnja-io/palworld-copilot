DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Clé 32 octets en base64 (openssl rand -base64 32), chiffre les credentials SFTP par serveur
SAVE_CREDS_KEY=
# Upload de saves locales (co-op) : token RW Vercel Blob (upload direct navigateur + worker)
BLOB_READ_WRITE_TOKEN=
# repository_dispatch pour déclencher le worker import-upload après un upload
GITHUB_REPO=owner/repo
# Fine-grained PAT, permission Contents: Read and write (déclenche le dispatch)
GITHUB_DISPATCH_TOKEN=
